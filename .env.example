# VictoryFairySpringServer local environment example.
# Copy values into your local shell or a private .env file. Do not commit real secrets.

SERVER_PORT=8081

# AI diary draft. Groq keys must stay server-side only.
AI_DIARY_ENABLED=false
MATCH_OUTLOOK_AI_ENABLED=false
GROQ_API_KEY=replace-with-rotated-server-only-key
GROQ_MODEL=llama-3.1-8b-instant
AI_DIARY_DAILY_LIMIT=10
AI_DIARY_TIMEOUT_SECONDS=12

# KBO scraped-dev is for local/test data only.
KBO_SCRAPED_DEV_ENABLED=true
KBO_SCRAPED_DEV_SCHEDULER_ENABLED=false
KBO_SOURCE_LABEL_MODE=dev

# Optional local protection for dev collector/import endpoints.
ADMIN_IMPORT_TOKEN=

# Legal/policy pages.
APP_HOMEPAGE_URL=https://hwangseokbeom.github.io/VictoryFairy-legal/
TERMS_URL=https://hwangseokbeom.github.io/VictoryFairy-legal/terms.html
PRIVACY_POLICY_URL=https://hwangseokbeom.github.io/VictoryFairy-legal/privacy.html
SUPPORT_URL=https://hwangseokbeom.github.io/VictoryFairy-legal/support.html
ACCOUNT_DELETION_URL=https://hwangseokbeom.github.io/VictoryFairy-legal/delete-account.html
DISCLAIMER_URL=https://hwangseokbeom.github.io/VictoryFairy-legal/disclaimer.html
COMMUNITY_POLICY_URL=https://hwangseokbeom.github.io/VictoryFairy-legal/community-policy.html

# Community is enabled for local/dev. Production defaults to disabled unless explicitly enabled.
COMMUNITY_ENABLED=true
COMMUNITY_POSTS_REQUIRE_PROFILE=true
COMMUNITY_BLOCK_ENABLED=true

# Profile images are optional. Clients should resize before upload; the server validates and resizes again.
PROFILE_IMAGE_UPLOAD_ENABLED=true
PROFILE_IMAGE_MAX_BYTES=2097152
PROFILE_IMAGE_MAX_SIDE=512
PROFILE_IMAGE_UPLOAD_DIR=data/uploads/profile

# Baseball news. Naver credentials must stay server-side only.
NEWS_PROVIDER=naver
NAVER_CLIENT_ID=replace-with-naver-client-id
NAVER_CLIENT_SECRET=replace-with-naver-client-secret
NAVER_NEWS_BASE_URL=https://openapi.naver.com/v1/search/news.json
NEWS_CACHE_TTL_SECONDS=1800
