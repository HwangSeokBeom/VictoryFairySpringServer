# VictoryFairySpringServer local environment example.
# Copy values into your local shell or a private .env file. Do not commit real secrets.

SERVER_PORT=8081

# AI diary draft. Groq keys must stay server-side only.
AI_DIARY_ENABLED=false
GROQ_API_KEY=replace-with-rotated-server-only-key
GROQ_MODEL=llama-3.1-8b-instant
AI_DIARY_DAILY_LIMIT=10
AI_DIARY_TIMEOUT_SECONDS=12

# KBO scraped-dev is for local/test data only.
KBO_SCRAPED_DEV_ENABLED=true
KBO_SCRAPED_DEV_SCHEDULER_ENABLED=false
KBO_SOURCE_LABEL_MODE=dev

# Optional local protection for dev collector/import endpoints.
ADMIN_IMPORT_TOKEN=

# Community write scaffold is disabled by default.
COMMUNITY_ENABLED=false
COMMUNITY_POLICY_URL=https://hwangseokbeom.github.io/VictoryFairy-legal/community-policy.html

# Baseball news. Naver credentials must stay server-side only.
NEWS_PROVIDER=naver
NAVER_CLIENT_ID=replace-with-naver-client-id
NAVER_CLIENT_SECRET=replace-with-naver-client-secret
NAVER_NEWS_BASE_URL=https://openapi.naver.com/v1/search/news.json
NEWS_CACHE_TTL_SECONDS=1800
